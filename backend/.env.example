# Backend Environment Variables Template
# Copy this to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Configuration (CHANGE THESE IN PRODUCTION)
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# Database Configuration
# For Render: use /var/data/learnpath.sqlite (persistent disk)
DB_PATH=/var/data/learnpath.sqlite

# CORS Configuration
# Use the deployed Vercel frontend URL in Render's environment variables.
CORS_ORIGIN=https://learn-path-t5r3-go6i8i6sp-geetha-123.vercel.app
