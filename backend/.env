# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=learnpath_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Database Configuration
# For local development, SQLite file will be created in the backend folder
# For Render, set this to /var/data/learnpath.sqlite (persistent disk)
DB_PATH=./learnpath.sqlite

# CORS Configuration
# For local development
CORS_ORIGIN=http://localhost:5173
